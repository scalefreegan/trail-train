  "crew_info": {
    "rules": [
      "Crew access only at the five signed crew points; everywhere else the forest road is closed to crew vehicles.",
      "A runner who stops must tell an aid captain before leaving the course.",
      "Park in pull-offs only — the road is one lane with blind corners."
    ],
    "cell_strategy": "Signal exists on the rim road and nowhere below it. Wait in a pull-off inside coverage, then drive in when your runner is close.",
    "station_notes": {
      "Quartz Bench": "Turn off the rim road at the cattle guard; the aid is 1.4 mi in on the right.",
      "Slabtown": "The only crew point with lights. Headlamps and the night layer go in the drop bag here.",
      "Stonecrop Saddle": "Pacer pickup. Park nose-out — the turnaround is tight.",
      "Tin Cup": "Last place with parking for more than three cars."
    },
    "start_notes": "Park at the trailhead lot the night before; the shuttle does not run."
  },
  "coach_notes": {
    "terrain": "Rocky rim singletrack with six sustained climbs and long runnable benches between them.",
    "climate": "Hot and dry on the benches from late morning; cold on the rim after dark.",
    "altitude": "Everything sits between 7,000 and 10,000 ft, so the whole course is at altitude.",
    "key_demands": "Climbing on tired legs, and eating through the hot middle third.",
    "race_week": "Arrive two days early if possible — the altitude is the part that cannot be faked."
  },
