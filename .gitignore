# Dependencies
node_modules/

# Build output
web/dist/
web/.vite/

# Local caches — Strava altitude streams fetched by `npm run sync:streams`.
.cache/

# Personal data snapshots — generated locally by `npm run sync:*`.
# These contain Strava activity history, Oura sleep/HRV/RHR/tags, and the
# agent's per-snapshot readout. Do NOT commit to a public repo.
web/public/strava.json
web/public/cross-train.json
web/public/oura.json
web/public/coach.json
web/public/state.json
# …and the one-shot v2 backup the v3 split leaves behind (same contents).
web/public/state.v2.backup.json
web/public/google-cal.json
web/public/climbs.json
# crew-base.json holds the race-week lodging address + drive times (from
# profile.json race_base) — personal, never commit.
web/public/crew-base.json

# Race folders — the configs themselves are committed; these are not.
# *.private.json holds crew addresses and emergency numbers, sources/ caches
# fetched pages and PDFs for re-intake diffs, build/ is generated output.
races/*/*.private.json
races/*/sources/
races/*/build/
# plan.json is agent-managed (the coach rewrites it every resync) and
# result.json records a real finish — both are personal/local like state.json.
# race.json, course.gpx, block.json and nutrition.json ARE committed.
races/*/plan.json
races/*/result.json
# The active-race pointer is a per-machine choice (and may name a draft that
# only exists locally) — never a committed one.
config/active-race.json

# Athlete profile (name, location, local trails). The committed file is the
# example with generic placeholders; copy it to profile.json and personalize.
config/profile.json

# Defense-in-depth: never let a stray in-repo backup folder leak snapshots.
backups/
trail-train-backups/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Env files
.env
.env.local
.env.*.local

# Gas City
.beads/*
!.beads/config.yaml
!.beads/metadata.json

# Local Claude tooling + screenshots — never commit (swept in by `git add -A` otherwise)
.claude/
web/.claude/
web/.shots/
web/public/pace-grade.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
