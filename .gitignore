# Dependencies
node_modules/

# Build output
web/dist/
web/dist-crew/
web/.vite/

# Playwright output — traces, screenshots and the HTML report from `npm run
# test:ui`. The suite's own fixtures under web/tests/fixtures/ ARE committed.
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# Local caches — Strava altitude streams fetched by `npm run sync:streams`.
.cache/

# Personal data snapshots — generated locally by `npm run sync:*`.
# These contain Strava activity history, Oura sleep/HRV/RHR/tags, and the
# agent's per-snapshot readout. Do NOT commit to a public repo.
web/public/strava.json
web/public/cross-train.json
web/public/oura.json
web/public/coach.json
web/public/state.json
# …and the one-shot v2 backup the v3 split leaves behind (same contents).
web/public/state.v2.backup.json
web/public/google-cal.json
web/public/climbs.json
# crew-base.json holds the race-week lodging address + drive times and the
# emergency numbers (from races/<slug>/crew.private.json) — never commit.
web/public/crew-base.json

# Race folders — the configs themselves are committed; these are not.
# *.private.json holds crew addresses and emergency numbers, sources/ caches
# fetched pages and PDFs for re-intake diffs, build/ is generated output.
races/*/*.private.json
races/*/sources/
races/*/build/
# The re-intake shadow folder: a whole second copy of the race, produced by
# "Refresh from sources" and deleted on Accept or Reject (scripts/race-refresh.mjs).
races/*/.refresh/
# plan.json is agent-managed (the coach rewrites it every resync) and
# result.json records a real finish — both are personal/local like state.json.
# race.json, course.gpx, block.json and nutrition.json ARE committed.
races/*/plan.json
races/*/result.json

# …except under races/_fixtures/, which is the opposite of personal data: the
# invented race folders the Playwright suite (web/tests/) copies into a temp
# root. An archived fixture race is only worth having WITH its result.json, so
# the folder-shape rules above are lifted for that one tree. Everything under
# it is synthetic by construction, and scripts/ui-fixtures.test.mjs greps it to
# keep it that way. (No crew.private.json fixture on purpose: it is the one
# race file whose schema is an address and phone numbers, and the suite does
# not need one — the dev server already answers /crew-base.json with {} for a
# folder that has none.)
!races/_fixtures/**
# …but the blanket re-inclusion above is a file-level "not personal data",
# not a "not generated output" rule — it otherwise overrides races/*/build/
# with no guard for that case. web/tests/launch.mjs and check-races.mjs both
# copy fixtures to a temp root before building, so this is currently latent,
# but a helper that ever builds a fixture IN PLACE must not have its output
# staged by a routine `git add -A`, unlike every other race folder's build
# output. sources/ and *.private.json get the same re-exclusion for the same
# reason, even though no fixture currently has either.
races/_fixtures/*/*.private.json
races/_fixtures/*/sources/
races/_fixtures/*/build/
# Same for the generic-mode plan the coach writes when no race is active.
config/generic-plan.json
# The active-race pointer is a per-machine choice (and may name a draft that
# only exists locally) — never a committed one.
config/active-race.json

# Generic-mode goals (event class, phase, volume band, injury notes). Same
# deal as the profile: goals.example.json is committed, goals.json is not and
# is bootstrapped from the example on first run.
config/goals.json

# Athlete profile (name, location, local trails). The committed file is the
# example with generic placeholders; copy it to profile.json and personalize.
config/profile.json

# Defense-in-depth: never let a stray in-repo backup folder leak snapshots.
backups/
trail-train-backups/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Env files
.env
.env.local
.env.*.local

# Gas City
.beads/*
!.beads/config.yaml
!.beads/metadata.json

# Local Claude tooling + screenshots — never commit (swept in by `git add -A` otherwise)
.claude/
web/.claude/
web/.shots/
web/public/pace-grade.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Gas City residue (orchestrator dropped 2026-09-18; something still recreates an empty events log)
.gc/
